{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acp-phase6-evaluation-manifest/1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "acp-phase6-evaluation-manifest/1"
    },
    "repository": {
      "const": "jeresaf/Application-Compiler-Platform"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "purpose": {
      "enum": [
        "SEALED_RELEASE_EVALUATION",
        "CANDIDATE_QUALIFICATION"
      ]
    },
    "release": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "SEALED_RELEASE"
            },
            "profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "generator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "releaseContractDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "bundleSeal": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "kind",
            "profile",
            "generator",
            "releaseContractDigest",
            "bundleSeal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "UNSEALED_CANDIDATE"
            },
            "profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "generator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "candidateSourceDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "ancestryDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "parentProfile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "parentBundleSeal": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "kind",
            "profile",
            "generator",
            "candidateSourceDigest",
            "ancestryDigest",
            "parentProfile",
            "parentBundleSeal"
          ],
          "additionalProperties": false
        }
      ]
    },
    "applicationSource": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "treeDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "inventory": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*$"
        }
      },
      "required": [
        "commit",
        "treeDigest",
        "inventory"
      ],
      "additionalProperties": false
    },
    "evaluator": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "treeDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "predicateSetDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "commit",
        "treeDigest",
        "predicateSetDigest"
      ],
      "additionalProperties": false
    },
    "auditSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "policyRef": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema",
        "payloadDigest"
      ],
      "additionalProperties": false
    },
    "registrationCheckpoint": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "sequence",
        "digest"
      ],
      "additionalProperties": false
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "application": {
            "enum": [
              "PAYMENT",
              "CASE_MANAGEMENT"
            ]
          },
          "canonicalDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "packageDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "generatedSourceDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "provenanceDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "application",
          "canonicalDigest",
          "packageDigest",
          "generatedSourceDigest",
          "provenanceDigest"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "approvalReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "purpose": {
            "enum": [
              "SEMANTIC_CONTENT",
              "DATA_BINDING",
              "MIGRATION_EXECUTION"
            ]
          },
          "reference": {
            "type": "object",
            "properties": {
              "schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "payloadDigest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "schema",
              "payloadDigest"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "purpose",
          "reference"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "executions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "contractDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "challengeRef": {
            "type": "object",
            "properties": {
              "schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "payloadDigest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "schema",
              "payloadDigest"
            ],
            "additionalProperties": false
          },
          "executorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "collectorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "environmentDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "provider": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "GITHUB_ACTIONS"
                  },
                  "repository": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "runId": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "attempt": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "jobId": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "workflowPath": {
                    "type": "string",
                    "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*$"
                  },
                  "workflowCommit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "testedCommit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                },
                "required": [
                  "kind",
                  "repository",
                  "runId",
                  "attempt",
                  "jobId",
                  "workflowPath",
                  "workflowCommit",
                  "testedCommit"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "ISOLATED_EXECUTOR"
                  },
                  "hostConfigurationDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "supervisorDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "sessionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "required": [
                  "kind",
                  "hostConfigurationDigest",
                  "supervisorDigest",
                  "sessionId"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "executionId",
          "contractDigest",
          "challengeRef",
          "executorId",
          "collectorId",
          "environmentDigest",
          "startedAt",
          "finishedAt",
          "provider"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 39
          },
          "predicateContractDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "registrationRef": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "schema": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "payloadDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "schema",
                  "payloadDigest"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceKind": {
            "enum": [
              "AUTOMATED",
              "HUMAN_REVIEW",
              "COMBINED"
            ]
          },
          "applicationScope": {
            "type": "array",
            "items": {
              "enum": [
                "PAYMENT",
                "CASE_MANAGEMENT"
              ]
            },
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true
          },
          "witnesses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "witnessId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "caseId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "application": {
                  "enum": [
                    "PAYMENT",
                    "CASE_MANAGEMENT"
                  ]
                },
                "executionId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "assertionArtifactPaths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*$"
                  },
                  "minItems": 1,
                  "maxItems": 4096,
                  "uniqueItems": true
                }
              },
              "required": [
                "witnessId",
                "caseId",
                "application",
                "executionId",
                "assertionArtifactPaths"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 4096,
            "uniqueItems": true
          },
          "artifactPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*$"
            },
            "minItems": 1,
            "maxItems": 4096,
            "uniqueItems": true
          }
        },
        "required": [
          "criterion",
          "predicateContractDigest",
          "registrationRef",
          "evidenceKind",
          "applicationScope",
          "witnesses",
          "artifactPaths"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 39,
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*$"
          },
          "role": {
            "enum": [
              "LOG",
              "JUNIT",
              "ASSERTIONS",
              "PACKAGE",
              "SBOM",
              "ENVIRONMENT",
              "SOURCE",
              "REVIEW",
              "OTHER_REGISTERED"
            ]
          },
          "mediaType": {
            "enum": [
              "application/json",
              "application/xml",
              "text/plain",
              "application/octet-stream",
              "application/x-tar"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "role",
          "mediaType",
          "size",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "required": [
    "schema",
    "repository",
    "manifestId",
    "purpose",
    "release",
    "applicationSource",
    "evaluator",
    "auditSessionId",
    "policyRef",
    "registrationCheckpoint",
    "applications",
    "approvalReferences",
    "executions",
    "criteria",
    "artifacts",
    "createdAt",
    "expiresAt"
  ],
  "additionalProperties": false
}
