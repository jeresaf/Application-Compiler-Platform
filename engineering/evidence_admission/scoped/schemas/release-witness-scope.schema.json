{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acp-phase6-release-witness-scope/1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "acp-phase6-release-witness-scope/1"
    },
    "repository": {
      "const": "jeresaf/Application-Compiler-Platform"
    },
    "laboratory": {
      "const": true
    },
    "release": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "SEALED_RELEASE"
            },
            "profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "generator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "releaseContractDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "bundleSeal": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "kind",
            "profile",
            "generator",
            "releaseContractDigest",
            "bundleSeal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "UNSEALED_CANDIDATE"
            },
            "profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "generator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "candidateSourceDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "ancestryDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "parentProfile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "parentBundleSeal": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "kind",
            "profile",
            "generator",
            "candidateSourceDigest",
            "ancestryDigest",
            "parentProfile",
            "parentBundleSeal"
          ],
          "additionalProperties": false
        }
      ]
    },
    "purpose": {
      "const": "QUALIFICATION_ONLY"
    },
    "policyRef": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema",
        "payloadDigest"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "treeDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*$"
        },
        "dependencyPath": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*$"
        },
        "dependencyDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "commit",
        "treeDigest",
        "entrypoint",
        "dependencyPath",
        "dependencyDigest"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "witnessId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "caseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "application": {
            "enum": [
              "PAYMENT",
              "CASE_MANAGEMENT"
            ]
          },
          "className": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sourcePath": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*$"
          },
          "criterion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 39
          },
          "assertionArtifactPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*$"
            },
            "minItems": 1,
            "maxItems": 4096,
            "uniqueItems": true
          }
        },
        "required": [
          "witnessId",
          "caseId",
          "application",
          "className",
          "method",
          "sourcePath",
          "criterion",
          "assertionArtifactPaths"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "predicateContracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 39
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "criterion",
          "digest"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 39,
      "uniqueItems": true
    },
    "expectedInputs": {
      "type": "object",
      "properties": {
        "executableDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": false
        },
        "workingDirectory": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*$"
        },
        "environmentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dependencyDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "executableDigest",
        "argv",
        "workingDirectory",
        "environmentDigest",
        "dependencyDigest"
      ],
      "additionalProperties": false
    },
    "validFrom": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "required": [
    "schema",
    "repository",
    "laboratory",
    "release",
    "purpose",
    "policyRef",
    "source",
    "cases",
    "predicateContracts",
    "expectedInputs",
    "validFrom",
    "validUntil"
  ],
  "additionalProperties": false
}
