{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acp-phase6-evidence/trust-snapshot/1",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "acp-phase6-evidence/trust-snapshot/1"
        },
        "recordId": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/recordId"
        },
        "repository": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/repository"
        },
        "issuedAt": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/timestamp"
        },
        "policyRef": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/trust-policyRef"
        },
        "snapshotSequence": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/integer"
        },
        "predecessorRef": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:acp-phase6-evidence:common:1#/$defs/trust-snapshotRef"
            }
          ]
        },
        "verifierRegistrationRefs": {
          "type": "array",
          "items": {
            "$ref": "urn:acp-phase6-evidence:common:1#/$defs/verifier-registrationRef"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true,
          "x-set-key": [
            "payloadDigest"
          ]
        },
        "humanRegistryRef": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/human-registryRef"
        },
        "revocationHeads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "registryId": {
                "$ref": "urn:acp-phase6-evidence:common:1#/$defs/registry"
              },
              "sequence": {
                "$ref": "urn:acp-phase6-evidence:common:1#/$defs/integer"
              },
              "headRef": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "urn:acp-phase6-evidence:common:1#/$defs/revocationRef"
                  }
                ]
              }
            },
            "required": [
              "registryId",
              "sequence",
              "headRef"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "x-set-key": [
            "registryId"
          ]
        }
      },
      "required": [
        "schema",
        "recordId",
        "repository",
        "issuedAt",
        "expiresAt",
        "policyRef",
        "snapshotSequence",
        "predecessorRef",
        "verifierRegistrationRefs",
        "humanRegistryRef",
        "revocationHeads"
      ],
      "additionalProperties": false
    },
    "payloadDigest": {
      "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
    },
    "signatures": {
      "type": "array",
      "items": {
        "$ref": "urn:acp-phase6-evidence:common:1#/$defs/signature"
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "x-set-key": [
        "signerId",
        "keyId"
      ]
    }
  },
  "required": [
    "payload",
    "payloadDigest",
    "signatures"
  ],
  "additionalProperties": false
}
