{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acp-phase6-evidence/admission-rejection/1",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "acp-phase6-evidence/admission-rejection/1"
        },
        "recordId": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/recordId"
        },
        "repository": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/repository"
        },
        "issuedAt": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/timestamp"
        },
        "policyRef": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/trust-policyRef"
        },
        "auditSessionId": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/session"
        },
        "submittedObjectDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        },
        "stage": {
          "type": "string",
          "enum": [
            "PARSE",
            "STRUCTURE",
            "AUTHENTICATION",
            "AUTHORIZATION",
            "REFERENCES",
            "ARTIFACTS",
            "EXECUTION",
            "PREDICATES",
            "PERSISTENCE"
          ]
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "$ref": "urn:acp-phase6-evidence:common:1#/$defs/reason"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "x-set-key": []
        },
        "relatedRefs": {
          "type": "array",
          "items": {
            "$ref": "urn:acp-phase6-evidence:common:1#/$defs/anyRecordRef"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true,
          "x-set-key": [
            "schema",
            "payloadDigest"
          ]
        },
        "trustSnapshotRef": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:acp-phase6-evidence:common:1#/$defs/trust-snapshotRef"
            }
          ]
        },
        "ledgerSequence": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/positive"
        },
        "predecessorRecordRef": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:acp-phase6-evidence:common:1#/$defs/admission-rejectionRef"
            }
          ]
        }
      },
      "required": [
        "schema",
        "recordId",
        "repository",
        "issuedAt",
        "expiresAt",
        "policyRef",
        "auditSessionId",
        "submittedObjectDigest",
        "stage",
        "reasonCodes",
        "relatedRefs",
        "trustSnapshotRef",
        "ledgerSequence",
        "predecessorRecordRef"
      ],
      "additionalProperties": false
    },
    "payloadDigest": {
      "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
    },
    "signatures": {
      "type": "array",
      "items": {
        "$ref": "urn:acp-phase6-evidence:common:1#/$defs/signature"
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "x-set-key": [
        "signerId",
        "keyId"
      ]
    }
  },
  "required": [
    "payload",
    "payloadDigest",
    "signatures"
  ],
  "additionalProperties": false
}
