{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acp-phase6-evidence/common/1",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
      "minLength": 71,
      "maxLength": 71
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?![\\s\\S])",
      "minLength": 40,
      "maxLength": 40
    },
    "recordId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}(?![\\s\\S])",
      "minLength": 32,
      "maxLength": 32
    },
    "timestamp": {
      "type": "string",
      "format": "acp-utc",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])",
      "minLength": 20,
      "maxLength": 20
    },
    "integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "criterion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 39
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*(?![\\s\\S])",
      "format": "acp-path"
    },
    "application": {
      "type": "string",
      "enum": [
        "PAYMENT",
        "CASE_MANAGEMENT"
      ]
    },
    "caseApplication": {
      "type": "string",
      "enum": [
        "PAYMENT",
        "CASE_MANAGEMENT",
        "SHARED_HOST"
      ]
    },
    "repository": {
      "const": "jeresaf/Application-Compiler-Platform"
    },
    "signatureBytes": {
      "type": "string",
      "format": "acp-signature",
      "pattern": "^[A-Za-z0-9_-]{86}(?![\\s\\S])",
      "minLength": 86,
      "maxLength": 86
    },
    "nonce": {
      "type": "string",
      "format": "acp-nonce",
      "pattern": "^[A-Za-z0-9_-]{43}(?![\\s\\S])",
      "minLength": 43,
      "maxLength": 43
    },
    "principal": {
      "type": "string",
      "pattern": "^principal:[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])",
      "maxLength": 80
    },
    "key": {
      "type": "string",
      "pattern": "^key:[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])",
      "maxLength": 80
    },
    "verifier": {
      "type": "string",
      "pattern": "^verifier:[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])",
      "maxLength": 80
    },
    "executor": {
      "type": "string",
      "pattern": "^executor:[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])",
      "maxLength": 80
    },
    "registry": {
      "type": "string",
      "pattern": "^registry:[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])",
      "maxLength": 80
    },
    "grant": {
      "type": "string",
      "pattern": "^grant:[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])",
      "maxLength": 80
    },
    "session": {
      "type": "string",
      "pattern": "^session:[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])",
      "maxLength": 80
    },
    "admission": {
      "type": "string",
      "pattern": "^admission:[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])",
      "maxLength": 80
    },
    "collector": {
      "type": "string",
      "pattern": "^collector:[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])",
      "maxLength": 80
    },
    "identity": {
      "oneOf": [
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/principal"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/key"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/verifier"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/executor"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/registry"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/grant"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/session"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/admission"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/collector"
        }
      ]
    },
    "engineering-envelopeRef": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "acp-phase6-evidence/engineering-envelope/1"
        },
        "payloadDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        }
      },
      "required": [
        "schema",
        "payloadDigest"
      ],
      "additionalProperties": false
    },
    "verifier-registrationRef": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "acp-phase6-evidence/verifier-registration/1"
        },
        "payloadDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        }
      },
      "required": [
        "schema",
        "payloadDigest"
      ],
      "additionalProperties": false
    },
    "execution-attestationRef": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "acp-phase6-evidence/execution-attestation/1"
        },
        "payloadDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        }
      },
      "required": [
        "schema",
        "payloadDigest"
      ],
      "additionalProperties": false
    },
    "artifact-manifestRef": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "acp-phase6-evidence/artifact-manifest/1"
        },
        "payloadDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        }
      },
      "required": [
        "schema",
        "payloadDigest"
      ],
      "additionalProperties": false
    },
    "human-decisionRef": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "acp-phase6-evidence/human-decision/1"
        },
        "payloadDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        }
      },
      "required": [
        "schema",
        "payloadDigest"
      ],
      "additionalProperties": false
    },
    "human-registryRef": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "acp-phase6-evidence/human-registry/1"
        },
        "payloadDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        }
      },
      "required": [
        "schema",
        "payloadDigest"
      ],
      "additionalProperties": false
    },
    "revocationRef": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "acp-phase6-evidence/revocation/1"
        },
        "payloadDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        }
      },
      "required": [
        "schema",
        "payloadDigest"
      ],
      "additionalProperties": false
    },
    "admission-receiptRef": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "acp-phase6-evidence/admission-receipt/1"
        },
        "payloadDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        }
      },
      "required": [
        "schema",
        "payloadDigest"
      ],
      "additionalProperties": false
    },
    "admission-rejectionRef": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "acp-phase6-evidence/admission-rejection/1"
        },
        "payloadDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        }
      },
      "required": [
        "schema",
        "payloadDigest"
      ],
      "additionalProperties": false
    },
    "trust-policyRef": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "acp-phase6-evidence/trust-policy/1"
        },
        "payloadDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        }
      },
      "required": [
        "schema",
        "payloadDigest"
      ],
      "additionalProperties": false
    },
    "trust-snapshotRef": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "acp-phase6-evidence/trust-snapshot/1"
        },
        "payloadDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        }
      },
      "required": [
        "schema",
        "payloadDigest"
      ],
      "additionalProperties": false
    },
    "execution-challengeRef": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "acp-phase6-evidence/execution-challenge/1"
        },
        "payloadDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        }
      },
      "required": [
        "schema",
        "payloadDigest"
      ],
      "additionalProperties": false
    },
    "witnessId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])",
      "maxLength": 128
    },
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}(?![\\s\\S])",
      "maxLength": 256
    },
    "anyRecordRef": {
      "oneOf": [
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/engineering-envelopeRef"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/verifier-registrationRef"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/execution-attestationRef"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/artifact-manifestRef"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/human-decisionRef"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/human-registryRef"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/revocationRef"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/admission-receiptRef"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/admission-rejectionRef"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/trust-policyRef"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/trust-snapshotRef"
        },
        {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/execution-challengeRef"
        }
      ]
    },
    "binding": {
      "type": "object",
      "properties": {
        "executionCommit": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/commit"
        },
        "evaluationCommit": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/commit"
        },
        "sourceTreeDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        },
        "bundleDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        },
        "approvalDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        },
        "canonicalDigests": {
          "type": "object",
          "properties": {
            "payment": {
              "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
            },
            "case-management": {
              "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
            }
          },
          "required": [
            "payment",
            "case-management"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "executionCommit",
        "evaluationCommit",
        "sourceTreeDigest",
        "bundleDigest",
        "approvalDigest",
        "canonicalDigests"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "application": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/application"
        },
        "snapshotDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        },
        "packageDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        }
      },
      "required": [
        "application",
        "snapshotDigest",
        "packageDigest"
      ],
      "additionalProperties": false
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "urn:acp-phase6-evidence:common:1#/$defs/subject"
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "x-set-key": [
        "application"
      ]
    },
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/path"
        },
        "role": {
          "type": "string",
          "enum": [
            "LOG",
            "JUNIT",
            "ASSERTIONS",
            "PACKAGE",
            "SBOM",
            "ENVIRONMENT",
            "SOURCE",
            "REVIEW",
            "OTHER_REGISTERED"
          ]
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "application/json",
            "application/xml",
            "text/plain",
            "application/octet-stream",
            "application/x-tar"
          ]
        },
        "size": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/integer"
        },
        "sha256": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        }
      },
      "required": [
        "path",
        "role",
        "mediaType",
        "size",
        "sha256"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "signerId": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/identity"
        },
        "keyId": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/key"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "signature": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/signatureBytes"
        }
      },
      "required": [
        "signerId",
        "keyId",
        "algorithm",
        "signature"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/repository"
        },
        "commit": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/commit"
        },
        "treeDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        },
        "entrypoint": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/path"
        },
        "dependencyManifestDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        }
      },
      "required": [
        "repository",
        "commit",
        "treeDigest",
        "entrypoint",
        "dependencyManifestDigest"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "criterion": {
          "type": "integer",
          "enum": [
            12,
            13,
            15,
            20,
            26,
            27,
            28
          ]
        },
        "applicationSubjects": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/subjects"
        },
        "deploymentReviewDigest": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
        },
        "evidenceManifestRef": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/artifact-manifestRef"
        }
      },
      "required": [
        "criterion",
        "applicationSubjects",
        "deploymentReviewDigest",
        "evidenceManifestRef"
      ],
      "additionalProperties": false
    },
    "termination": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "NORMAL_EXIT"
            },
            "exitCode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "kind",
            "exitCode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "SIGNAL"
            },
            "signalNumber": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "coreDumped": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "signalNumber",
            "coreDumped"
          ],
          "additionalProperties": false
        }
      ]
    },
    "case": {
      "type": "object",
      "properties": {
        "witnessId": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/witnessId"
        },
        "caseId": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/caseId"
        },
        "application": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/caseApplication"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "PASSED",
            "FAILED",
            "ERROR",
            "SKIPPED"
          ]
        },
        "assertionArtifactDigests": {
          "type": "array",
          "items": {
            "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "x-set-key": []
        }
      },
      "required": [
        "witnessId",
        "caseId",
        "application",
        "outcome",
        "assertionArtifactDigests"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "enum": [
        "INVALID_STRUCTURE",
        "INVALID_SIGNATURE",
        "UNKNOWN_ISSUER",
        "UNAUTHORIZED",
        "EXPIRED",
        "REVOKED",
        "REGISTRY_ROLLBACK",
        "REGISTRY_FORK",
        "MISSING_REVOCATION",
        "REPLAY",
        "SOURCE_MISMATCH",
        "SUBJECT_MISMATCH",
        "INCOMPLETE_EXECUTION",
        "ARTIFACT_MISMATCH",
        "INTERRUPTED",
        "UNSUPPORTED_VERSION",
        "UNSATISFIED_PREDICATE"
      ]
    }
  }
}
