{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acp-phase6-evidence/engineering-envelope/1",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "acp-phase6-evidence/engineering-envelope/1"
        },
        "recordId": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/recordId"
        },
        "repository": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/repository"
        },
        "issuedAt": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/timestamp"
        },
        "policyRef": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/trust-policyRef"
        },
        "binding": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/binding"
        },
        "subjects": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/subjects"
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "urn:acp-phase6-evidence:common:1#/$defs/criterion"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "x-set-key": []
        },
        "registrationRef": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/verifier-registrationRef"
        },
        "attestationRef": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/execution-attestationRef"
        },
        "manifestRef": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/artifact-manifestRef"
        },
        "challengeRef": {
          "$ref": "urn:acp-phase6-evidence:common:1#/$defs/execution-challengeRef"
        }
      },
      "required": [
        "schema",
        "recordId",
        "repository",
        "issuedAt",
        "expiresAt",
        "policyRef",
        "binding",
        "subjects",
        "criteria",
        "registrationRef",
        "attestationRef",
        "manifestRef",
        "challengeRef"
      ],
      "additionalProperties": false
    },
    "payloadDigest": {
      "$ref": "urn:acp-phase6-evidence:common:1#/$defs/digest"
    },
    "signatures": {
      "type": "array",
      "items": {
        "$ref": "urn:acp-phase6-evidence:common:1#/$defs/signature"
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "x-set-key": [
        "signerId",
        "keyId"
      ]
    }
  },
  "required": [
    "payload",
    "payloadDigest",
    "signatures"
  ],
  "additionalProperties": false
}
